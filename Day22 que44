#include<stdio.h>
int main()
{
int n,i,numerator=1,denominator=2;
float sum=0;
printf("enter number of terms");
scanf("%d",&n);
for(i=1;i<=n;i++)
{
if(i==1)
sum=sum+1;
else
sum=sum+(float)numerator/denominator;
numerator=numerator+2;
denominator=denominator+2;
}
printf("sum is %f",sum);
return 0;
}
